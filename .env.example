# Optional: start without this file and use the app's LLM settings instead.
# Saved settings in .local/llm.json take precedence over these startup defaults.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
HOST=127.0.0.1
PORT=5173
# SAMPLE_DIR=/absolute/path/to/your/optional/photos
# LLM_CONFIG_FILE=.local/llm.json
# Existing DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL remain supported
# when the corresponding LLM_* variable is absent.
